  "description": "MCP server for the Papyrio PDF API: compress, convert, merge, split and OCR PDFs from an assistant.",
  "license": "MIT",
  "homepage": "https://papyrio.net/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atabekdemurtaza/papyrio-mcp.git"
  },
